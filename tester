}

test tcall
test_stream tcall
test tdisc
test_stream tdisc
test tswitch
test tgoto
test tinlines
test_lto test-lto test-lto.c test-lto-2.c

if [ "$1" = "random" ] ; then
	for (( i=0; i < ${2:-10}; i++ )) ; do
		csmith > t$i.c
		test t$i
		rm t${i}.c t${i} t${i}.data t${i}.gcov t${i}.opt
	done
fi

trap "" ERR 0
