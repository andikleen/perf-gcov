#!/bin/bash
# basic tester

CC=${CC:-gcc}
PERF=${PERF:-perf}

# Find a GCC 16+ capable compiler for v3 format tests.
# Set CC_V3 environment variable to override auto-detection.
if [ -n "$CC_V3" ]; then
	:  # user-provided
elif command -v gcc-16 >/dev/null 2>&1; then
	CC_V3=gcc-16
else
	CC_V3=$CC
fi

PATH=$PATH:../autofdo/build

set -x
set -e

failed() {
        echo FAILED
}
trap failed ERR 0

# Check GCC version for v3 support
check_gcc_v3_support() {
	local version=$($CC_V3 -dumpversion | cut -d. -f1)
	if [ "$version" -ge 16 ]; then
		return 0  # GCC 16+ supports v3
	else
		return 1  # Older GCC, v3 not supported
	fi
}

if check_gcc_v3_support ; then
	GCC_GCOV_VERSION=3
	echo "Using $CC_V3 for v3 -fauto-profile tests"
else
	GCC_GCOV_VERSION=2
fi

cleanup_test_files() {
	local i=$1
	rm -f ${i}.gcov3 ${i}.dump3 ${i}.opt3 ${i}.dump ${i}.dump2 ${i}.dump3v ${i}.dump3v2 ${i}.offsets ${i}.offsets2 ${i}.offsets.missing ${i}.gcov2 ${i}.gcov3_ref ${i}.stream.gcov ${i}.optafdo ${i}ref-${i}.c.*.afdo ${i}new-${i}.c.*.afdo
}

# Compare gcov.py output with create_gcov reference.
# Usage: diff_check <testname> [version]
#   version defaults to 2; gcov.py uses ${i}.gcov, reference stored as ${i}.gcov2
#   version 3: gcov.py uses ${i}.gcov3, reference stored as ${i}.gcov3_ref
diff_check() {
	local i=$1
	local version=${2:-2}
	local gcov_file="${i}.gcov"
	local gcov_ref="${i}.gcov2"
	local dump_file="${i}.dump"
	local ref_dump="${i}.dump2"
	if [ "$version" = "3" ] ; then
		gcov_file="${i}.gcov3"
		gcov_ref="${i}.gcov3_ref"
		dump_file="${i}.dump3v"
		ref_dump="${i}.dump3v2"
	fi
	if [ -z "$(type -p create_gcov)" ] ; then
		echo "create_gcov not found, skipping reference comparison"
		return 0
	fi
	echo "autofdo dump (v${version})"
	dump_gcov ${gcov_file} > ${dump_file}
	cat ${dump_file}
	create_gcov -gcov_version ${version} --binary ${i} --gcov ${gcov_ref} --profile ${i}.data
	echo "autofdo reference dump (v${version})"
	dump_gcov ${gcov_ref} > ${ref_dump}
	cat ${ref_dump}
	echo "diff gcov.py vs create_gcov (v${version})"
	if ! diff -u ${dump_file} ${ref_dump} ; then
		echo "non-identical dump accepted; checking non-zero offsets"
	fi
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${dump_file} | sort -u > ${i}.offsets
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${ref_dump} | sort -u > ${i}.offsets2
	comm -23 ${i}.offsets ${i}.offsets2 > ${i}.offsets.missing
	if [ -s ${i}.offsets.missing ] ; then
		echo "source line offsets missing from create_gcov reference"
		cat ${i}.offsets.missing
		false
	fi
}

# Test gcov-stream-profile.sh (streaming pipeline without perf.data)
test_stream() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c

echo "=== Testing gcov-stream-profile.sh (v2) ==="
./gcov-stream-profile.sh --binary ${i} --gcov ${i}.stream.gcov --min-samples 1 --gcov-version 2 -- ./${i}

echo "Stream pipeline dump:"
./gcov-dump.py --max-count 3000000 ${i}.stream.gcov

# Compile with the streamed profile
$CC -g -O2 -fauto-profile=${i}.stream.gcov ${i}.c -o ${i}.stream.opt
./${i}.stream.opt

echo "=== Testing gcov-stream-profile.sh (v3) ==="
./gcov-stream-profile.sh --binary ${i} --gcov ${i}.stream.gcov3 --min-samples 1 --gcov-version 3 -- ./${i}

echo "v3 stream pipeline dump:"
./gcov-dump.py ${i}.stream.gcov3

if [ $GCC_GCOV_VERSION = 3 ] ; then
	echo "GCC 16+ detected, testing v3 stream profile with -fauto-profile"
	$CC_V3 -g -O2 -fauto-profile=${i}.stream.gcov3 ${i}.c -o ${i}.stream.opt3
	./${i}.stream.opt3
	echo "v3 stream profile works with GCC!"
else
	echo "GCC < 16, skipping -fauto-profile test for v3 stream (format validation only)"
fi

# Cleanup stream-specific files
rm -f ${i}.stream.gcov ${i}.stream.gcov3 ${i}.stream.opt ${i}.stream.opt3
}

# Test function for test-lto (multi-file with LTO)
test_lto() {
local i=$1
shift
local sources="$@"
$CC -g -O2 -flto -o ${i} ${sources}
$PERF record -b -o ${i}.data -c 50001 -e branches:ppu ./${i}

# Test v2 (default test, backward compatibility)
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --min-samples 1 --binary ${i} --gcov-version 2
./gcov-dump.py --max-count 3000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i}
fi
$CC -dumpbase ${i}new -w -g -O2 -flto -fdump-unnumbered -fdump-ipa-afdo -fauto-profile=${i}.gcov ${sources} -o ${i}.opt
./${i}.opt
if [ -n "$(type -p create_gcov)" ] ; then
	$CC -dumpbase ${i}ref -w -g -O2 -flto -fdump-unnumbered -fdump-ipa-afdo -fauto-profile=${i}.gcov ${sources} -o ${i}.optafdo
	if [ -f ${i}.optafdo ] ; then
		for ref_file in ${i}ref-*.afdo; do
			[ -f "$ref_file" ] || continue
			new_file="${ref_file/ref-/new-}"
			if [ -f "$new_file" ]; then
				diff -u "$ref_file" "$new_file"
			fi
		done
		cmp ${i}.opt ${i}.optafdo
	fi
fi

# Test v3
echo "=== Testing GCOV v3 format ==="
$PERF script -i ${i}.data gcov.py ${i}.gcov3 --verbose --min-samples 1 --binary ${i} --gcov-version 3
echo "v3 dump:"
./gcov-dump.py ${i}.gcov3 > ${i}.dump3
cat ${i}.dump3
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i} 3
fi

if [ $GCC_GCOV_VERSION == 3 ] ; then
	$CC_V3 -g -O2 -flto -fauto-profile=${i}.gcov3 ${sources} -o ${i}.opt3
	./${i}.opt3
else
	echo "GCC < 16, skipping -fauto-profile test for v3 (format validation only)"
fi

# Cleanup temporary test files
cleanup_test_files ${i}
}

test() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c
$PERF record -b -o ${i}.data -c 50001 -e branches:ppu ./${i}

# Test v2 (default test, backward compatibility)
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --min-samples 1 --binary ${i} --gcov-version 2
./gcov-dump.py --max-count 3000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i}
fi
$CC -dumpbase ${i}new -w -g -O2 -fdump-unnumbered -fdump-ipa-afdo -fauto-profile=${i}.gcov ${i}.c -o ${i}.opt
./${i}.opt
if [ -n "$(type -p create_gcov)" ] ; then
	$CC -dumpbase ${i}ref -w -g -O2 -fdump-unnumbered -fdump-ipa-afdo -fauto-profile=${i}.gcov ${i}.c -o ${i}.optafdo
	if [ -f ${i}.optafdo ] ; then
		diff -u ${i}ref-${i}.c.*.afdo ${i}new-${i}.c.*.afdo
		cmp ${i}.opt ${i}.optafdo
	fi
fi

# Test v3 (new format with source files)
echo "=== Testing GCOV v3 format ==="
$PERF script -i ${i}.data gcov.py ${i}.gcov3 --verbose --min-samples 1 --binary ${i} --gcov-version 3
echo "v3 dump:"
./gcov-dump.py ${i}.gcov3 > ${i}.dump3
cat ${i}.dump3
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i} 3
fi

if [ $GCC_GCOV_VERSION == 3 ] ; then
	$CC_V3 -g -O2 -fauto-profile=${i}.gcov3 ${i}.c -o ${i}.opt3
	./${i}.opt3
else
	echo "GCC < 16, skipping -fauto-profile test for v3 (format validation only)"
fi

# Cleanup temporary test files
cleanup_test_files ${i}
}

test tcall
test_stream tcall
test tdisc
test_stream tdisc
test tswitch
test tgoto
test tinlines
test tinlines2
test tindirect
test_lto test-lto test-lto.c test-lto-2.c

if [ "$1" = "random" ] ; then
	for (( i=0; i < ${2:-10}; i++ )) ; do
		csmith > t$i.c
		test t$i
		rm t${i}.c t${i} t${i}.data t${i}.gcov t${i}.opt
	done
fi

trap "" ERR 0
