#!/bin/bash
# basic tester

CC=${CC:-gcc}
PERF=${PERF:-perf}

set -x
set -e

failed() {
        echo FAILED
}
trap failed ERR 0

# Check GCC version for v3 support
check_gcc_v3_support() {
	local version=$($CC -dumpversion | cut -d. -f1)
	if [ "$version" -ge 16 ]; then
		return 0  # GCC 16+ supports v3
	else
		return 1  # Older GCC, v3 not supported
	fi
}

cleanup_test_files() {
	local i=$1
	rm -f ${i}.gcov3 ${i}.dump3 ${i}.opt3 ${i}.dump ${i}.dump2 ${i}.offsets ${i}.offsets2 ${i}.offsets.missing ${i}.gcov2 ${i}.stream.gcov
}

# Compare gcov.py output with create_gcov reference
diff_check() {
	local i=$1
	echo "autofdo dump"
	dump_gcov ${i}.gcov > ${i}.dump
	cat ${i}.dump
	create_gcov -gcov_version 2 --binary ${i} --gcov ${i}.gcov2 --profile ${i}.data
	echo "autofdo reference dump"
	dump_gcov ${i}.gcov2 > ${i}.dump2
	cat ${i}.dump2
	echo "diff gcov.py vs create_gcov"
	if ! diff -u ${i}.dump ${i}.dump2 ; then
		echo "non-identical dump accepted; checking non-zero offsets"
	fi
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${i}.dump | sort -u > ${i}.offsets
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${i}.dump2 | sort -u > ${i}.offsets2
	comm -23 ${i}.offsets ${i}.offsets2 > ${i}.offsets.missing
	if [ -s ${i}.offsets.missing ] ; then
		echo "source line offsets missing from create_gcov reference"
		cat ${i}.offsets.missing
		false
	fi
}

# Test gcov-stream-profile.sh (streaming pipeline without perf.data)
test_stream() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c

echo "=== Testing gcov-stream-profile.sh (v2) ==="
# XXX probe gcc for needed version
./gcov-stream-profile.sh --binary ${i} --gcov ${i}.stream.gcov --gcov-version 2 -- ./${i}

echo "Stream pipeline dump:"
./gcov-dump.py --max-count 1000000 ${i}.stream.gcov

# Compile with the streamed profile
$CC -g -O2 -fauto-profile=${i}.stream.gcov ${i}.c -o ${i}.stream.opt
./${i}.stream.opt

echo "=== Testing gcov-stream-profile.sh (v3) ==="
./gcov-stream-profile.sh --binary ${i} --gcov ${i}.stream.gcov3 --gcov-version 3 -- ./${i}

echo "v3 stream pipeline dump:"
./gcov-dump.py ${i}.stream.gcov3

if check_gcc_v3_support ; then
	echo "GCC 16+ detected, testing v3 stream profile with -fauto-profile"
	$CC -g -O2 -fauto-profile=${i}.stream.gcov3 ${i}.c -o ${i}.stream.opt3
	./${i}.stream.opt3
	echo "v3 stream profile works with GCC!"
else
	echo "GCC < 16, skipping -fauto-profile test for v3 stream (format validation only)"
fi

# Cleanup stream-specific files
rm -f ${i}.stream.gcov ${i}.stream.gcov3 ${i}.stream.opt ${i}.stream.opt3
}

# Test function for test-lto (multi-file with LTO)
test_lto() {
local i=$1
shift
local sources="$@"
$CC -g -O2 -flto -o ${i} ${sources}
$PERF record -b -o ${i}.data -c 10001 -e branches:ppu ./${i}

# Test v2 (default test, backward compatibility)
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --binary ${i} --gcov-version 2
./gcov-dump.py --max-count 1000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i}
fi
$CC -g -O2 -flto -fauto-profile=${i}.gcov ${sources} -o ${i}.opt
./${i}.opt

# Test v3 (new format with source files)
echo "=== Testing GCOV v3 format ==="
$PERF script -i ${i}.data gcov.py ${i}.gcov3 --verbose --binary ${i} --gcov-version 3
echo "v3 dump:"
./gcov-dump.py ${i}.gcov3 > ${i}.dump3
cat ${i}.dump3

if check_gcc_v3_support ; then
	echo "GCC 16+ detected, testing with -fauto-profile"
	$CC -g -O2 -flto -fauto-profile=${i}.gcov3 ${sources} -o ${i}.opt3
	./${i}.opt3
	echo "v3 profile works with GCC!"
else
	echo "GCC < 16, skipping -fauto-profile test for v3 (format validation only)"
fi

# Cleanup temporary test files
cleanup_test_files ${i}
}

test() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c
$PERF record -b -o ${i}.data -c 10001 -e branches:ppu ./${i}

# Test v2 (default test, backward compatibility)
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --binary ${i} --gcov-version 2
./gcov-dump.py --max-count 1000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	diff_check ${i}
fi
$CC -g -O2 -fauto-profile=${i}.gcov ${i}.c -o ${i}.opt
./${i}.opt

# Test v3 (new format with source files)
echo "=== Testing GCOV v3 format ==="
$PERF script -i ${i}.data gcov.py ${i}.gcov3 --verbose --binary ${i} --gcov-version 3
echo "v3 dump:"
./gcov-dump.py ${i}.gcov3 > ${i}.dump3
cat ${i}.dump3

if check_gcc_v3_support ; then
	echo "GCC 16+ detected, testing with -fauto-profile"
	$CC -g -O2 -fauto-profile=${i}.gcov3 ${i}.c -o ${i}.opt3
	./${i}.opt3
	echo "v3 profile works with GCC!"
