#!/bin/bash
# basic tester

CC=${CC:-gcc}
PERF=${PERF:-perf}

set -x
set -e

failed() {
        echo FAILED
}
trap failed ERR 0

test() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c
$PERF record -b -o ${i}.data -c 10001 -e branches:ppu ./${i}
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --binary ${i}
./dump.py --max-count 1000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	echo "autofdo dump"
	dump_gcov ${i}.gcov > ${i}.dump
	cat ${i}.dump
	create_gcov -gcov_version 2 --binary ${i} --gcov ${i}.gcov2 --profile ${i}.data
	echo "autofdo reference dump"
	dump_gcov ${i}.gcov2 > ${i}.dump2
	cat ${i}.dump2
	# gcov.py is branch/LBR based while create_gcov is sample+range based,
	# so head counts and the set of body positions differ by design. The
	# diff is informational only; line offsets should however line up.
	echo "diff gcov.py vs create_gcov (informational)"
	diff -u ${i}.dump ${i}.dump2 || true
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); print }' ${i}.dump | sort -u > ${i}.offsets
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); print }' ${i}.dump2 | sort -u > ${i}.offsets2
	comm -23 ${i}.offsets ${i}.offsets2 > ${i}.offsets.missing
	if [ -s ${i}.offsets.missing ] ; then
		echo "offsets missing from create_gcov reference"
		cat ${i}.offsets.missing
		false
	fi
fi
$CC -g -O2 -fauto-profile=${i}.gcov ${i}.c -o ${i}.opt
./${i}.opt
}

test tcall
test tdisc
test tswitch
test tgoto
test tinlines

if [ "$1" = "random" ] ; then
	for (( i=0; i < ${2:-10}; i++ )) ; do
		csmith > t$i.c
		test t$i
		rm t${i}.c t${i} t${i}.data t${i}.gcov t${i}.opt
	done
fi

trap "" ERR 0
