#!/bin/bash
# basic tester

CC=${CC:-gcc}
PERF=${PERF:-perf}

set -x
set -e

failed() {
        echo FAILED
}
trap failed ERR 0

# Check GCC version for v3 support
check_gcc_v3_support() {
	local version=$($CC -dumpversion | cut -d. -f1)
	if [ "$version" -ge 16 ]; then
		return 0  # GCC 16+ supports v3
	else
		return 1  # Older GCC, v3 not supported
	fi
}

cleanup_test_files() {
	local i=$1
	rm -f ${i}.gcov3 ${i}.dump3 ${i}.opt3 ${i}.dump ${i}.dump2 ${i}.offsets ${i}.offsets2 ${i}.offsets.missing ${i}.gcov2
}

test() {
local i=$1
$CC -g -O2 -o ${i} ${i}.c
$PERF record -b -o ${i}.data -c 10001 -e branches:ppu ./${i}

# Test v2 (default test, backward compatibility)
$PERF script -i ${i}.data gcov.py ${i}.gcov --verbose --binary ${i} --gcov-version 2
./dump.py --max-count 1000000 ${i}.gcov
if [ -n "$(type -p dump_gcov)" ] ; then
	echo "autofdo dump"
	dump_gcov ${i}.gcov > ${i}.dump
	cat ${i}.dump
	create_gcov -gcov_version 2 --binary ${i} --gcov ${i}.gcov2 --profile ${i}.data
	echo "autofdo reference dump"
	dump_gcov ${i}.gcov2 > ${i}.dump2
	cat ${i}.dump2
	echo "diff gcov.py vs create_gcov"
	if ! diff -u ${i}.dump ${i}.dump2 ; then
		echo "non-identical dump accepted; checking non-zero offsets"
	fi
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${i}.dump | sort -u > ${i}.offsets
	awk '/^[[:space:]]+[0-9]+(\.[0-9]+)?:/ && $2 != 0 { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); sub(/\..*/, ""); print }' ${i}.dump2 | sort -u > ${i}.offsets2
	comm -23 ${i}.offsets ${i}.offsets2 > ${i}.offsets.missing
	if [ -s ${i}.offsets.missing ] ; then
		echo "source line offsets missing from create_gcov reference"
		cat ${i}.offsets.missing
		false
	fi
fi
$CC -g -O2 -fauto-profile=${i}.gcov ${i}.c -o ${i}.opt
./${i}.opt

# Test v3 (new format with source files)
echo "=== Testing GCOV v3 format ==="
$PERF script -i ${i}.data gcov.py ${i}.gcov3 --verbose --binary ${i} --gcov-version 3
echo "v3 dump:"
./dump.py ${i}.gcov3 > ${i}.dump3
cat ${i}.dump3

if check_gcc_v3_support ; then
	echo "GCC 16+ detected, testing with -fauto-profile"
	$CC -g -O2 -fauto-profile=${i}.gcov3 ${i}.c -o ${i}.opt3
	./${i}.opt3
	echo "v3 profile works with GCC!"
else
	echo "GCC < 16, skipping -fauto-profile test for v3 (format validation only)"
fi

# Cleanup temporary test files
cleanup_test_files ${i}
}

test tcall
test tdisc
test tswitch
test tgoto
test tinlines

if [ "$1" = "random" ] ; then
	for (( i=0; i < ${2:-10}; i++ )) ; do
		csmith > t$i.c
		test t$i
		rm t${i}.c t${i} t${i}.data t${i}.gcov t${i}.opt
	done
fi

trap "" ERR 0
